{
  "manifest_version": 3,
  "name": "TinyTab",
  "short_name": "TinyTab",
  "version": "2.3.2",
  "description": "Record what you do on a web page once. TinyTab replays it with its own virtual mouse, in as many tabs as you like.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/off-16.png",
    "32": "icons/off-32.png",
    "48": "icons/off-48.png",
    "128": "icons/on-128.png"
  },
  "action": {
    "default_title": "TinyTab: click to turn on",
    "default_icon": {
      "16": "icons/off-16.png",
      "32": "icons/off-32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "webNavigation",
    "debugger",
    "offscreen",
    "clipboardWrite",
    "browsingData"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/util.js",
        "content/locator.js",
        "content/recorder.js",
        "content/player.js",
        "content/sense.js",
        "content/deck.js",
        "content/main.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/clipboard-main.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "Turn TinyTab on or off in this tab"
    },
    "toggle-record": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Start or stop recording"
    },
    "toggle-play": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Start or stop playback"
    }
  }
}
